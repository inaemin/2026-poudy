#!/bin/sh
#
# OpenAPI 생성물을 갱신해 지금 만들어지는 커밋에 포함시킨다.
# pre-push 가 아니라 pre-commit 인 이유: 커밋이 확정되기 전이라야
# 재생성한 파일을 git add 로 같은 커밋에 넣을 수 있다.

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# server 소스가 스테이징된 커밋에서만 돈다.
# 프론트엔드나 문서만 고친 커밋은 그냥 통과한다.
if git diff --cached --quiet -- server/src; then
    exit 0
fi

echo "[pre-commit] OpenAPI 생성물 갱신 중..."

if ! (cd server && ./gradlew generateApiTypes --quiet --no-daemon); then
    echo "[pre-commit] 생성에 실패했습니다."
    echo "  기본 JDK 가 21 이 아니면 아래로 확인해 보세요."
    echo "  JAVA_HOME=\$(/usr/libexec/java_home -v 21) ./gradlew generateApiTypes"
    exit 1
fi

targets="server/openapi.json common/api.d.ts"

if git diff --quiet -- $targets; then
    echo "[pre-commit] 변경 없음."
else
    git add $targets
    echo "[pre-commit] 갱신된 생성물을 이번 커밋에 포함했습니다."
    git --no-pager diff --cached --stat -- $targets
fi
