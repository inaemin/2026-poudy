# dev 프로필의 기본 접속 정보를 덮어쓸 때만 쓰는 견본. 필수가 아니다.
#
#   cp .env.example .env
#
# compose.yaml 이 띄우는 로컬 PostgreSQL 을 쓴다면 이 파일은 필요 없다.
# dev 프로필이 같은 값을 기본값으로 들고 있어 .env 없이 그대로 뜬다.
# 포트를 바꿨거나 다른 로컬 DB 를 쓸 때만 만든다.
#
# 운영 접속 정보는 절대 여기에 적지 않는다. dev 프로필로 뜬 앱은 Flyway 로
# 마이그레이션을 실행하므로, 운영 DB 를 가리키면 로컬 실행만으로 운영 스키마가
# 바뀐다. 운영 값은 배포 환경의 환경 변수로만 주입한다.
#
# .env 는 커밋되지 않는다. 실제 환경 변수가 .env 보다 우선한다.

DB_URL=jdbc:postgresql://localhost:5432/poudy
DB_USERNAME=poudy
DB_PASSWORD=poudy
