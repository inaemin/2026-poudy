<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  WootecoStyle.xml 중 포매터가 고칠 수 없는 두 가지만 둔다.
  형식 규칙은 config/formatter.xml 담당이라 여기 넣지 않는다.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- IF/WHILE/FOR/DOWHILE_BRACE_FORCE=3. 포매터는 줄만 펼치고 중괄호는 못 넣는다. -->
        <module name="NeedBraces">
            <property name="tokens"
                      value="LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE, LITERAL_DO"/>
        </module>

        <!-- CLASS/NAMES_COUNT_TO_USE_IMPORT_ON_DEMAND=999 -->
        <module name="AvoidStarImport"/>
    </module>

</module>
